<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Quiz - Quiz Master</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <nav>
        <div class="logo">QUIZ MASTER</div>

        <div class="nav-links">
            <a href="index.html">Home</a>
            <a href="quiz.html">Quizzes</a>
            <a href="login.html">Login</a>
            <a href="register.html">Register</a>
        </div>
    </nav>

    <main>

        <section class="quiz-section">

            <div class="quiz-box">

                <h1>General Knowledge Quiz</h1>

                <p>Test your knowledge with these questions.</p>

                <div class="question">
                    <h3>1. What is the capital of India?</h3>

                    <label>
                        <input type="radio" name="q1" value="Mumbai">
                        Mumbai
                    </label>

                    <label>
                        <input type="radio" name="q1" value="New Delhi">
                        New Delhi
                    </label>

                    <label>
                        <input type="radio" name="q1" value="Chennai">
                        Chennai
                    </label>

                    <label>
                        <input type="radio" name="q1" value="Kolkata">
                        Kolkata
                    </label>
                </div>

                <div class="question">
                    <h3>2. Which language is mainly used for web page structure?</h3>

                    <label>
                        <input type="radio" name="q2" value="Python">
                        Python
                    </label>

                    <label>
                        <input type="radio" name="q2" value="HTML">
                        HTML
                    </label>

                    <label>
                        <input type="radio" name="q2" value="SQL">
                        SQL
                    </label>

                    <label>
                        <input type="radio" name="q2" value="Java">
                        Java
                    </label>
                </div>

                <div class="question">
                    <h3>3. Which one is a programming language?</h3>

                    <label>
                        <input type="radio" name="q3" value="Python">
                        Python
                    </label>

                    <label>
                        <input type="radio" name="q3" value="HTML">
                        HTML
                    </label>

                    <label>
                        <input type="radio" name="q3" value="CSS">
                        CSS
                    </label>

                    <label>
                        <input type="radio" name="q3" value="JPEG">
                        JPEG
                    </label>
                </div>

                <button type="button" class="btn" onclick="submitQuiz()">
                    Submit Quiz
                </button>

                <p id="result"></p>

            </div>

        </section>

    </main>

    <footer>
        <p>© 2026 Quiz Master. All Rights Reserved.</p>
    </footer>

    <script>
        function submitQuiz() {

            let score = 0;

            const answer1 = document.querySelector('input[name="q1"]:checked');
            const answer2 = document.querySelector('input[name="q2"]:checked');
            const answer3 = document.querySelector('input[name="q3"]:checked');

            if (answer1 && answer1.value === "New Delhi") {
                score++;
            }

            if (answer2 && answer2.value === "HTML") {
                score++;
            }

            if (answer3 && answer3.value === "Python") {
                score++;
            }

            document.getElementById("result").innerHTML =
                "Your Score: " + score + " / 3";
        }
    </script>

</body>

</html>
